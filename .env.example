# Copy to .env.local for local work. Never commit real values.
# In Vercel, set these under Project Settings > Environment Variables.

# ---- Supabase (Singapore project) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the export and deletion jobs, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Public address used in emails and parent-consent links.
SITE_URL=http://localhost:3000
# Comma-separated SHA-256 hashes of valid adviser staff codes.
STAFF_CODE_HASHES=
# Long random string. Vercel Cron sends it as "Authorization: Bearer <value>".
CRON_SECRET=

# ---- AI feedback (optional; off for under-18 accounts whatever this says) ----
# gemini or stub. stub returns fixed text and never calls the network.
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Email (optional; without a key emails are logged, not sent) ----
RESEND_API_KEY=
EMAIL_FROM=CareerPrep <no-reply@example.com>
