# ---- Data ----
# supabase = real accounts and a database. fixtures = one in-memory sample student, for tests.
DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only; never expose to the browser

# Staff (advisers, institution users) sign up with this code. Pick a long random string.
STAFF_INVITE_CODE=

# Public address of the app, used in booking emails.
SITE_URL=http://localhost:3000

# ---- AI for hints and interview feedback ----
# openai, anthropic or gemini, plus that provider's key. recorded = no AI (static hints only).
LLM_PROVIDER=gemini
# LLM_MODEL=                      # optional; defaults: gpt-4o-mini, claude-haiku-5-5, gemini-3.8-flash
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Booking emails (optional) ----
# Without a key, emails are logged instead of sent. https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=CareerPrep <bookings@your-domain>

# Thresholds (defaults shown)
# MATCH_CONFIDENCE_THRESHOLD=0.6
# MASTERY_PASS_MARK=0.8
