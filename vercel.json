{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npx --yes pnpm@10.12.1 install --no-frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.12.1 ls --depth 0 && npx next build",
  "regions": ["sin1"],
  "crons": [
    { "path": "/careerprep/api/cron/reminders", "schedule": "0 1 * * *" },
    { "path": "/careerprep/api/cron/purge", "schedule": "0 19 * * *" }
  ]
}
