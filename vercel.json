{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npx --yes pnpm@10.12.1 install --no-frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.12.1 ls --depth 0 && npx next build",
  "regions": ["sin1"],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 1 * * *" },
    { "path": "/api/cron/purge", "schedule": "0 19 * * *" }
  ],
  "rewrites": [
    { "source": "/careerprep", "destination": "https://careerprep-sigma.vercel.app" },
    { "source": "/careerprep/:path*", "destination": "https://careerprep-sigma.vercel.app/:path*" }
  ]
}
