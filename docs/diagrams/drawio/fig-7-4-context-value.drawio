<mxfile host="drawio" type="device"><diagram name="Figure 7.4 System context and value exchange (C4 model, level 1)" id="fig-7-4-context-value"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ins" value='&lt;b&gt;Career-services officer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Buys the licence for&lt;br&gt;the institution&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;verticalAlign=top;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="440" y="20" width="220" height="130" as="geometry"/></mxCell><mxCell id="cp" value='&lt;b&gt;CareerPrep&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Maps modules to jobs,&lt;br&gt;teaches gaps, rehearses&lt;br&gt;interviews&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;rounded=1;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="250" width="220" height="120" as="geometry"/></mxCell><mxCell id="stu" value='&lt;b&gt;Diploma student&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Uses CareerPrep&lt;br&gt;free of charge&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;verticalAlign=top;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="200" height="130" as="geometry"/></mxCell><mxCell id="adv" value='&lt;b&gt;Career adviser&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Meets students who&lt;br&gt;ask for help&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;verticalAlign=top;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="220" height="130" as="geometry"/></mxCell><mxCell id="mym" value='&lt;b&gt;MYMahir&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system, TalentCorp]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Skills taxonomy&lt;br&gt;and courses&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;rounded=1;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="190" width="210" height="110" as="geometry"/></mxCell><mxCell id="mfj" value='&lt;b&gt;MyFutureJobs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External system, PERKESO]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;National job&lt;br&gt;matching&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;rounded=1;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="330" width="210" height="110" as="geometry"/></mxCell><mxCell id="key" value="Key" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="480" width="210" height="150" as="geometry"/></mxCell><mxCell id="k1" value="Person" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;rou