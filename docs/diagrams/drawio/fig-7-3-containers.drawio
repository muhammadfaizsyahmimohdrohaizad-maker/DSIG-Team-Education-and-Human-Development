<mxfile host="drawio" type="device"><diagram name="Figure 7.3 CareerPrep containers (C4 model, level 2)" id="fig-7-3-containers"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="770" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="u1" value='&lt;b&gt;Diploma student&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Maps modules to jobs&lt;br&gt;and practises&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;verticalAlign=top;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="150" y="20" width="180" height="120" as="geometry"/></mxCell><mxCell id="u2" value='&lt;b&gt;Career adviser&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Reviews students and&lt;br&gt;handles bookings&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;verticalAlign=top;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="390" y="20" width="180" height="120" as="geometry"/></mxCell><mxCell id="bd" value='&lt;b&gt;CareerPrep&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System]&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=2;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#444444;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="100" y="190" width="700" height="410" as="geometry"/></mxCell><mxCell id="web" value='&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Container: Next.js PWA]&lt;/span&gt;&lt;br&gt;&lt