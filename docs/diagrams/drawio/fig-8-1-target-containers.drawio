<mxfile host="drawio" type="device"><diagram name="Figure 8.1 CareerPrep with the recommended upgrades (C4 model, level 2)" id="fig-8-1-target-containers"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="890" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="u1" value='&lt;b&gt;Diploma student&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Maps modules to jobs&lt;br&gt;and practises&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;verticalAlign=top;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="180" height="120" as="geometry"/></mxCell><mxCell id="u2" value='&lt;b&gt;Career adviser&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Reviews students and&lt;br&gt;handles bookings&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;verticalAlign=top;spacingTop=34;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="180" height="120" as="geometry"/></mxCell><mxCell id="obs" value='&lt;b&gt;Notes app&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[External: Obsidian]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Opens the exported&lt;br&gt;portfolio&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;rounded=1;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="30" width="160" height="100" as="geometry"/></mxCell><mxCell id="mail" value='&lt;b&gt;Email provi